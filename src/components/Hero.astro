---

<section class="relative bg-gradient-to-r from-primary-900 to-primary-700 text-white pt-28 pb-16 md:pt-32 md:pb-24">
  <div class="absolute inset-0 overflow-hidden">
    <svg class="absolute bottom-0 left-0 w-full h-16 text-white fill-current" viewBox="0 0 1440 48">
      <path d="M0 48h1440V0c-192 22.4-384 32-576 28.8C672 25.6 480 9.6 288 0 192 0 96 16 0 48z"></path>
    </svg>
  </div>
  
  <div class="container-custom relative z-10">
    <div class="grid md:grid-cols-2 gap-8 items-center">
      <div class="animate-on-scroll">
        <h1 class="text-white mb-4">Expert Garage Door Services in Dallas</h1>
        <p class="text-primary-100 text-xl mb-6">Professional installation, repair, and maintenance for your home or business</p>
        <div class="flex flex-wrap gap-4">
          <a href="#contact" class="btn-accent">
            <span class="flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              Schedule Service
            </span>
          </a>
          <a href="tel:555-123-4567" class="btn-secondary">
            <span class="flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              Call Now
            </span>
          </a>
        </div>
        <div class="mt-8 flex items-center">
          <div class="bg-accent-500 text-white font-bold uppercase tracking-wide text-xs px-3 py-1 rounded-full">24/7 Emergency Service</div>
          <div class="ml-4 text-primary-50">We're always available for urgent repairs</div>
        </div>
      </div>
      
      <div class="animate-on-scroll">
        <img 
          src="https://images.pexels.com/photos/5551740/pexels-photo-5551740.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2" 
          alt="Professional garage door installation" 
          class="rounded-lg shadow-2xl w-full object-cover object-center h-[400px]"
        />
      </div>
    </div>
  </div>
</section>

<div class="bg-gray-50 py-4 border-b border-gray-200">
  <div class="container-custom">
    <div class="flex flex-wrap justify-center md:justify-between items-center gap-6">
      <div class="flex items-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent-500 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span class="font-medium">Locally Owned & Operated</span>
      </div>
      <div class="flex items-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent-500 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span class="font-medium">Licensed & Insured</span>
      </div>
      <div class="flex items-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent-500 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span class="font-medium">5-Star Service</span>
      </div>
      <div class="flex items-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent-500 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span class="font-medium">Same-Day Service</span>
      </div>
    </div>
  </div>
</div>