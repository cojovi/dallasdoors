---
const projects = [
  {
    title: 'Modern Residential Installation',
    description: 'Custom installation of a modern garage door for a residential home in Dallas.',
    image: '/images/gallery1.svg'
  },
  {
    title: 'Commercial Upgrade',
    description: 'Installation of industrial-grade doors for a commercial warehouse facility.',
    image: '/images/gallery2.svg'
  },
  {
    title: 'Broken Spring Repair',
    description: 'Emergency repair service for a residential garage door with broken springs.',
    image: '/images/gallery3.svg'
  },
  {
    title: 'Traditional Door Installation',
    description: 'Custom wood panel garage door installation for a traditional-style home.',
    image: '/images/gallery4.svg'
  }
];
---

<section class="section bg-gray-50">
  <div class="container-custom">
    <div class="section-title animate-on-scroll">
      <h2>Our Recent Projects</h2>
      <p class="max-w-2xl mx-auto text-center text-gray-600">Take a look at some of our recent work. We take pride in our craftsmanship and attention to detail.</p>
    </div>
    
    <div class="grid md:grid-cols-2 gap-8 mt-12">
      {projects.map((project) => (
        <div class="card overflow-hidden group animate-on-scroll">
          <div class="relative h-64 overflow-hidden">
            <img 
              src={project.image} 
              alt={project.title}
              class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
            />
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold mb-2">{project.title}</h3>
            <p class="text-gray-600">{project.description}</p>
          </div>
        </div>
      ))}
    </div>
    
    <div class="mt-12 text-center animate-on-scroll">
      <a href="#contact" class="btn-primary">
        <span class="flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
          See More Projects
        </span>
      </a>
    </div>
  </div>
</section>