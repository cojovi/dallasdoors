---
const testimonials = [
  {
    name: "Jamie Carter",
    text: "Dallas Door Pros provided excellent service! They fixed my garage door quickly and efficiently. The technician was knowledgeable and friendly, explaining everything clearly. I'll definitely use their services again!",
    rating: 5,
    image: "https://images.pexels.com/photos/733872/pexels-photo-733872.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2"
  },
  {
    name: "Alex Martinez",
    text: "Outstanding service from Dallas Door Pros! Prompt, reliable, and their expertise in garage door repairs is unmatched. They arrived when they said they would and completed the job within the estimated time frame. Highly recommend!",
    rating: 5,
    image: "https://images.pexels.com/photos/220453/pexels-photo-220453.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2"
  },
  {
    name: "Samantha Lewis",
    text: "Dallas Door Pros exceeded my expectations! Their quick response and efficient service made a big difference. They installed a new garage door for us, and the quality of both the product and installation is excellent.",
    rating: 5,
    image: "https://images.pexels.com/photos/1239291/pexels-photo-1239291.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2"
  }
];

const renderStars = (rating) => {
  let stars = '';
  for (let i = 0; i < 5; i++) {
    if (i < rating) {
      stars += `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-yellow-500" viewBox="0 0 20 20" fill="currentColor">
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
      </svg>`;
    } else {
      stars += `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-300" viewBox="0 0 20 20" fill="currentColor">
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
      </svg>`;
    }
  }
  return stars;
};
---

<section id="testimonials" class="section bg-gray-50">
  <div class="container-custom">
    <div class="section-title animate-on-scroll">
      <h2>What Our Customers Say</h2>
      <p class="max-w-2xl mx-auto text-center text-gray-600">Don't just take our word for it. Here's what our satisfied customers have to say about our garage door services.</p>
    </div>
    
    <div class="grid md:grid-cols-3 gap-8 mt-12">
      {testimonials.map((testimonial, index) => (
        <div class="testimonial-card group hover:shadow-lg transition-all duration-300 animate-on-scroll">
          <div class="p-1">
            <div class="flex items-center mb-4">
              <img 
                src={testimonial.image} 
                alt={testimonial.name}
                class="w-14 h-14 rounded-full object-cover mr-4 border-2 border-primary-100"
              />
              <div>
                <div class="font-bold text-gray-800">{testimonial.name}</div>
                <div class="flex mt-1">
                  <Fragment set:html={renderStars(testimonial.rating)} />
                </div>
              </div>
            </div>
            
            <svg class="w-10 h-10 text-primary-100 mb-2" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
            </svg>
            
            <p class="text-gray-600 mb-4">{testimonial.text}</p>
            
            <div class="mt-4 flex justify-end">
              <div class="text-sm text-gray-500 italic">Verified Customer</div>
            </div>
          </div>
        </div>
      ))}
    </div>
    
    <div class="mt-16 text-center animate-on-scroll">
      <div class="inline-flex items-center bg-primary-50 text-primary-700 px-6 py-3 rounded-lg border border-primary-200">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary-600 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span class="font-medium">
          Join our growing list of 500+ satisfied customers!
        </span>
      </div>
    </div>
  </div>
</section>