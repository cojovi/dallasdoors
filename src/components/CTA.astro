---
---

<section class="py-16 bg-gradient-to-r from-primary-700 to-primary-600 text-white relative overflow-hidden">
  <div class="absolute inset-0 bg-pattern opacity-10"></div>
  
  <div class="container-custom relative z-10">
    <div class="grid md:grid-cols-2 gap-8 items-center">
      <div class="animate-on-scroll">
        <h2 class="text-white">Need Garage Door Service Today?</h2>
        <p class="text-primary-100 text-lg mb-8">We offer same-day service for most repairs and maintenance requests. Our team is ready to help you with all your garage door needs.</p>
        
        <div class="flex flex-wrap gap-4">
          <a href="#contact" class="btn-accent">
            <span class="flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              Schedule Service
            </span>
          </a>
          <a href="tel:555-123-4567" class="btn-secondary">
            <span class="flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              555-123-4567
            </span>
          </a>
        </div>
      </div>
      
      <div class="animate-on-scroll">
        <div class="bg-white text-gray-800 p-6 rounded-lg shadow-custom">
          <h3 class="text-xl font-bold mb-3">Emergency Service</h3>
          <p class="mb-4">Garage door not working? Don't wait! Our emergency service is available 24/7 to address your urgent garage door issues.</p>
          
          <div class="flex items-center mb-4 text-gray-700">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent-500 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Fast response times</span>
          </div>
          
          <div class="flex items-center mb-4 text-gray-700">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent-500 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span>Trained for all emergencies</span>
          </div>
          
          <div class="flex items-center mb-6 text-gray-700">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent-500 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
            <span>No extra fees for weekends</span>
          </div>
          
          <a href="tel:555-123-4567" class="btn-accent w-full flex justify-center">
            <span class="flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              Call for Emergency Service
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .bg-pattern {
    background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.1'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  }
</style>