<section id="about" class="section bg-white">
  <div class="container-custom">
    <div class="grid md:grid-cols-2 gap-8 items-center">
      <div class="animate-on-scroll">
        <h2>About Dallas Door Pros</h2>
        <p class="text-lg mb-6">For over 15 years, Dallas Door Pros has been the trusted name in garage door services throughout Dallas and surrounding areas.</p>
        
        <p class="mb-6">We take pride in our commitment to quality workmanship, exceptional customer service, and reliable solutions for all your garage door needs. Our team of certified technicians brings expertise and professionalism to every job, ensuring your satisfaction.</p>
        
        <div class="grid grid-cols-2 gap-4 mb-8">
          <div class="flex items-start">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-accent-500 mr-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <div>
              <h4 class="font-bold mb-1">Experienced</h4>
              <p class="text-gray-600 text-sm">Over 15 years in business</p>
            </div>
          </div>
          
          <div class="flex items-start">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-accent-500 mr-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <div>
              <h4 class="font-bold mb-1">Certified</h4>
              <p class="text-gray-600 text-sm">Licensed technicians</p>
            </div>
          </div>
          
          <div class="flex items-start">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-accent-500 mr-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <div>
              <h4 class="font-bold mb-1">Reliable</h4>
              <p class="text-gray-600 text-sm">On-time service guarantee</p>
            </div>
          </div>
          
          <div class="flex items-start">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-accent-500 mr-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <div>
              <h4 class="font-bold mb-1">Affordable</h4>
              <p class="text-gray-600 text-sm">Competitive pricing</p>
            </div>
          </div>
        </div>
        
        <a href="#contact" class="btn-primary">
          <span class="flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
            Contact Us Today
          </span>
        </a>
      </div>
      
      <div class="space-y-4 animate-on-scroll">
        <img 
          src="https://images.pexels.com/photos/5691506/pexels-photo-5691506.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2" 
          alt="Dallas Door Pros team" 
          class="rounded-lg shadow-custom w-full h-64 object-cover object-center"
        />
        <div class="grid grid-cols-2 gap-4">
          <img 
            src="https://images.pexels.com/photos/9825240/pexels-photo-9825240.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2" 
            alt="Garage door installation" 
            class="rounded-lg shadow-custom w-full h-40 object-cover object-center"
          />
          <img 
            src="https://images.pexels.com/photos/5750766/pexels-photo-5750766.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2" 
            alt="Garage door repair" 
            class="rounded-lg shadow-custom w-full h-40 object-cover object-center"
          />
        </div>
      </div>
    </div>
  </div>
</section>